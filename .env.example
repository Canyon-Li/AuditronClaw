# AuditronClaw 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# ==================== 模型配置 ====================

# 默认模型提供商 (可选：openai, anthropic, aliyun, tencent, z.ai, ollama, other)
DEFAULT_PROVIDER=aliyun

# 默认模型名称
DEFAULT_MODEL=glm-5

# ==================== OpenAI 兼容配置 ====================
# 适用于：OpenAI、阿里云、腾讯云、Z.AI 等兼容接口

# API Key (必填，除非使用 Ollama)
OPENAI_API_KEY=sk-your-api-key-here

# Base URL (可选，使用官方接口可留空或注释)
# OpenAI 官方：https://api.openai.com/v1
# 阿里云：https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云 coding: https://coding.dashscope.aliyuncs.com/v1
OPENAI_API_BASE=https://coding.dashscope.aliyuncs.com/v1

# ==================== Anthropic 配置 ====================
# 仅在 DEFAULT_PROVIDER=anthropic 时使用

# API Key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Base URL (可选，使用代理时配置)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==================== Ollama 配置 ====================
# 仅在 DEFAULT_PROVIDER=ollama 时使用

# Ollama 本地服务地址 (默认：http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ==================== 邮箱事务台配置（可选）====================
# 示例场景：定时只读邮箱 → 分类总结 → 待办落盘 → 飞书摘要推送
# 部署步骤详见 docs/deploy/mailbox-desk.md
# 凭据纪律：以下三项只存在宿主机 .env，永远不进工具参数、返回值与审计日志

# QQ 邮箱账号（需先在 QQ 邮箱设置中开启 IMAP/SMTP 服务）
MAIL_ACCOUNT=your-qq-account@qq.com

# QQ 邮箱 IMAP 授权码（非登录密码：设置 → 账户 → IMAP/SMTP 服务 → 生成授权码）
MAIL_IMAP_PASSWORD=your-imap-authorization-code

# 飞书自定义机器人 webhook URL（群设置 → 群机器人 → 添加自定义机器人，免签模式）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
